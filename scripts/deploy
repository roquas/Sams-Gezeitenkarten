#!/usr/bin/env bash
set -euo pipefail

# Deploy the GitHub Actions artifact for the current remote branch tip.
HOST='roquas@roquas.uber.space'
REMOTE_ROOT='www/roquas.de/sgz'
REPO='roquas/Sams-Gezeitenkarten'
REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  echo "Aufruf: ./scripts/deploy <name> (z. B. ./scripts/deploy pr40)" >&2
  exit 2
}
[[ $# -eq 1 ]] || usage
NAME=$1
[[ "$NAME" =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]] || { echo 'Ungültiger Versionsname.' >&2; exit 2; }
command -v gh >/dev/null || { echo 'GitHub CLI fehlt (brew install gh; gh auth login).' >&2; exit 1; }
command -v unzip >/dev/null || { echo 'unzip fehlt.' >&2; exit 1; }

BRANCH="$(git -C "$REPO_ROOT" symbolic-ref --quiet --short HEAD)" || {
  echo 'Kein lokaler Branch ausgecheckt. Bitte Branch auswählen.' >&2; exit 1;
}
# Read the remote branch, not the local checkout. No git pull is necessary.
SHA="$(gh api "repos/$REPO/branches/$BRANCH" --jq '.commit.sha')" || {
  echo "Remote-Branch nicht gefunden: $BRANCH" >&2; exit 1;
}
RUN_ID="$(gh run list --repo "$REPO" --workflow tests.yml --commit "$SHA" --status success --limit 30 --json databaseId --jq '.[0].databaseId // empty')" || exit 1
[[ -n "$RUN_ID" ]] || {
  echo "Noch kein erfolgreicher Tests-Workflow für $BRANCH ($SHA)." >&2
  echo 'Bitte warten, bis GitHub Actions erfolgreich abgeschlossen ist.' >&2
  exit 1
}
echo "Branch: $BRANCH"
echo "Commit: $SHA"
echo "Erfolgreicher Workflow-Lauf: $RUN_ID"

TEMP_DIR="$(mktemp -d)"
cleanup_local() { rm -rf -- "$TEMP_DIR"; }
trap cleanup_local EXIT
gh run download "$RUN_ID" --repo "$REPO" --name static-deployment --dir "$TEMP_DIR"
ZIP="$TEMP_DIR/dist/Sams-Gezeitenkarten.zip"
[[ -f "$ZIP" ]] || {
  echo "Deployment-ZIP fehlt im Artefakt: dist/Sams-Gezeitenkarten.zip" >&2; exit 1;
}
unzip -tq "$ZIP" >/dev/null || { echo 'Deployment-ZIP ist beschädigt.' >&2; exit 1; }

# The upload is temporary. A published version is never overwritten.
UPLOAD=$(ssh -o BatchMode=yes "$HOST" "mkdir -p ~/$REMOTE_ROOT && mktemp ~/$REMOTE_ROOT/.upload-XXXXXXXX.zip")
cleanup() { ssh -o BatchMode=yes "$HOST" "rm -f '$UPLOAD'" >/dev/null 2>&1 || true; }
trap cleanup EXIT
scp -q -o BatchMode=yes "$ZIP" "$HOST:$UPLOAD"

ssh -o BatchMode=yes "$HOST" "bash -s -- '$NAME' '$UPLOAD' '$REMOTE_ROOT'" <<'REMOTE'
set -euo pipefail
name=$1
upload=$2
root="$HOME/$3"
cd "$root"
command -v unzip >/dev/null || { echo 'Fehler: unzip fehlt auf dem Server.' >&2; exit 1; }

# Atomic directory creation prevents two simultaneous deploys from choosing
# the same version number.
if ! mkdir .deploy-lock 2>/dev/null; then
  echo 'Ein anderes Deployment läuft bereits (.deploy-lock vorhanden).' >&2
  exit 1
fi
stage=''
finish() {
  if [[ -n "$stage" && -d "$stage" ]]; then rm -rf -- "$stage"; fi
  rmdir .deploy-lock 2>/dev/null || true
}
trap finish EXIT

max=0
shopt -s nullglob
for path in "$name"-[0-9][0-9][0-9]*; do
  [[ -d "$path" ]] || continue
  suffix=${path#"$name"-}
  [[ "$suffix" =~ ^[0-9]+$ ]] || continue
  number=$((10#$suffix))
  if (( number > max )); then max=$number; fi
done
next=$((max+1))
printf -v target '%s-%03d' "$name" "$next"
[[ ! -e "$target" ]] || { echo "Ziel existiert bereits: $target" >&2; exit 1; }

stage=$(mktemp -d './.deploy-stage-XXXXXXXX')
unzip -q "$upload" -d "$stage"

# Allow one enclosing ZIP directory, but publish index.html at the URL root.
if [[ ! -f "$stage/index.html" ]]; then
  entries=("$stage"/*)
  if [[ ${#entries[@]} -eq 1 && -d "${entries[0]}" && -f "${entries[0]}/index.html" ]]; then
    inner=${entries[0]}
    mv "$inner" "$stage-content"
    rmdir "$stage"
    stage="$stage-content"
  fi
fi
for required in index.html src puzzles assets; do
  [[ -e "$stage/$required" ]] || { echo "ZIP unvollständig: $required fehlt" >&2; exit 1; }
done
if find "$stage/src" -type f -name '*.mjs' -print -quit | grep -q .; then
  echo 'Fehler: .mjs-Dateien im Deployment-src gefunden.' >&2
  exit 1
fi
mv -- "$stage" "$target"
stage=''
printf 'Bereitgestellt: %s\n' "$target"
printf 'Verzeichnis: %s/%s\n' "$root" "$target"
REMOTE
