{
  "type": "object",
  "required": [
    "schemaVersion",
    "defaultId",
    "puzzles"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "defaultId": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "const": null
        }
      ]
    },
    "assetCatalog": {
      "type": "string",
      "pattern": "^(?:[.][.]/)*[A-Za-z0-9_./-]+[.]json$"
    },
    "resourceBase": {
      "type": "string",
      "pattern": "^(?:[.][.]/|[.]/|[A-Za-z0-9_-]+/)*$"
    },
    "puzzles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "path",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^(?:[.][.]/)*[A-Za-z0-9_./-]+[.]json$"
          },
          "kind": {
            "enum": [
              "demo",
              "test",
              "editorial"
            ]
          },
          "difficulty": {
            "type": "string"
          }
        }
      }
    }
  }
}
